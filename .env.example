# Copy to .env (git-ignored) and fill in. Spring Boot loads ./.env through spring.config.import.
DB_PASSWORD=
# base64 string, at least 64 bytes of entropy for HS512, e.g.: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# ---- E-mail (password reset) ----
# Real delivery with Gmail: turn on 2-step verification, create an "App password", use it as MAIL_PASSWORD.
MAIL_USERNAME=
MAIL_PASSWORD=
# Optional: who the message claims to be from (Gmail rewrites it to the account address anyway)
MAIL_FROM=
# Defaults are Gmail (smtp.gmail.com:587, auth + STARTTLS), so leave MAIL_HOST/PORT/SMTP_AUTH/STARTTLS out (an empty
# value would override the default). For a local mail catcher such as Mailpit/Mailtrap (nothing leaves your machine)
# add these four lines instead:
#   MAIL_HOST=localhost
#   MAIL_PORT=1025
#   MAIL_SMTP_AUTH=false
#   MAIL_STARTTLS=false
# Base URL of the frontend, used to build the reset link
FRONTEND_URL=http://localhost:3000
# ---- Social sign-in (Google / Facebook / LinkedIn) ----
# A button on the log-in forms turns on once its id AND secret are set. In each console register this redirect URI
# (BACKEND_URL below, then the path):  <BACKEND_URL>/api/v1/auth/oauth/<google|facebook|linkedin>/callback
#   GOOGLE_CLIENT_ID=
#   GOOGLE_CLIENT_SECRET=
#   FACEBOOK_CLIENT_ID=
#   FACEBOOK_CLIENT_SECRET=
#   LINKEDIN_CLIENT_ID=
#   LINKEDIN_CLIENT_SECRET=
# Public address of this API. The one-click "unsubscribe" header of the weekly digest points here (HTTPS in production).
# With an https address the e-mails link their logos (<BACKEND_URL>/mail/itjobs-logo.png); with http they carry them inline.
#   BACKEND_URL=http://localhost:8080
# Who is e-mailed when something waits for an admin: a new company to approve, a reported job post. Comma separated;
# leave it out and nobody is mailed (accounts are never guessed from the seeded admin).
#   ADMIN_ALERT_EMAIL=you@example.com
# Optional mail schedules (Spring cron, "-" = off): weekly job-alert digest and daily Premium renewal reminder.
#   JOB_ALERT_CRON=0 0 8 * * MON
#   PLAN_REMINDER_CRON=0 0 9 * * *
#   HR_DIGEST_CRON=0 30 8 * * *
#   SAVED_JOB_REMINDER_CRON=0 30 9 * * *
#   JOB_EXPIRY_REMINDER_CRON=0 0 10 * * *
#   PIN_CLEANUP_CRON=0 */10 * * * *
#   INTERVIEW_REMINDER_CRON=0 0 * * * *

# ---- Payments (VNPay / ZaloPay / MoMo sandbox) ----
# Register a free sandbox merchant at https://sandbox.vnpayment.vn/devreg/ , then copy the terminal code and secret here.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# VNPay return URL: FRONTEND_URL/ (default http://localhost:3000/).
# Register the public HTTPS IPN URL with VNPay: https://your-backend/api/v1/payments/vnpay-ipn
# MoMo: get TEST credentials at https://business.momo.vn/ (integration settings).
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# Defaults to BACKEND_URL/api/v1/payments/momo-ipn. Set a public HTTPS URL to receive IPN.
# MOMO_IPN_URL=https://your-backend/api/v1/payments/momo-ipn
# MOMO_RECONCILE_CRON=15 * * * * *
# ZaloPay merchant sandbox credentials. Key1 signs API requests; Key2 verifies callbacks.
ZALOPAY_APP_ID=0
ZALOPAY_KEY1=
ZALOPAY_KEY2=
# Optional public HTTPS callback (localhost cannot receive server-to-server callbacks).
# ZALOPAY_CALLBACK_URL=https://your-backend/api/v1/payments/zalopay-callback
# Status reconciliation runs every minute; set to - to disable.
# ZALOPAY_RECONCILE_CRON=0 * * * * *
# Dev only: PAYMENT_MOCK=true shows a fake gateway page (no credentials needed). Never in production.
PAYMENT_MOCK=false

# Optional: log every SQL statement (off by default)
# SHOW_SQL=true
