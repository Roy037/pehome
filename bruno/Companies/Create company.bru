meta {
  name: Create company
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/companies
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Công ty mẫu",
    "address": "Hà Nội",
    "description": "<p>Giới thiệu</p>",
    "logo": "",
    "banner": "1790000000000-banner.png",
    "website": "https://congty.example.com",
    "companyType": "PRODUCT",
    "mapEmbedUrl": "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3724",
    "facebookUrl": "https://www.facebook.com/congty",
    "linkedinUrl": "https://www.linkedin.com/company/congty",
    "twitterUrl": "https://x.com/congty",
    "pinterestUrl": "",
    "instagramUrl": "https://www.instagram.com/congty",
    "youtubeUrl": "https://www.youtube.com/@congty"
  }
}

docs {
  Optional profile fields: companyType PRODUCT | OUTSOURCE; website must be http(s); mapEmbedUrl must be a Google Maps EMBED url (https://www.google.com/maps/embed?... or https://maps.google.com/maps?...&output=embed); each social link must be https on its own network's domain. Blank values are stored as null. HR may only update their own company.
}
