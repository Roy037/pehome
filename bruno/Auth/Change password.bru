meta {
  name: Change password
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/auth/change-password
  body: json
  auth: inherit
}

body:json {
  {
    "currentPassword": "123456",
    "newPassword": "new-password-123"
  }
}

docs {
  Signed-in user. Wrong current password counts toward the login limit (8 tries / 15 minutes). Afterwards every session is signed out and a notice e-mail is sent.
}
