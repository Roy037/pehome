meta {
  name: Admin: fetch all reviews
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/reviews?page=1&size=10&sort=updatedAt,desc&filter=rating : 1
  body: none
  auth: inherit
}

params:query {
  page: 1
  size: 10
  sort: updatedAt,desc
  ~filter: rating : 1
}

docs {
  Requires REVIEWS permission (granted to SUPER_ADMIN on startup).
}
