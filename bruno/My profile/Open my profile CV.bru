meta {
  name: Open my profile CV
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/me/profile/cv?index=0
  body: none
  auth: inherit
}

params:query {
  index: 0
}

docs {
  Streams one file saved in my own profile. index counts from 0 in the order of cvs (default 0). 400 if there is no such file.
}
